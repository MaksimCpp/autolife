# Local development. Fill every empty password or key with local-only values.
AUTOLIFE_LOG_LEVEL=info
AUTOLIFE_HTTP_ADDR=:8080
AUTOLIFE_MAX_BODY_BYTES=105000000
AUTOLIFE_DB_MAX_CONNS=10
AUTOLIFE_API_DATABASE_URL=
AUTOLIFE_WORKER_DATABASE_URL=
AUTOLIFE_MIGRATION_DATABASE_URL=
AUTOLIFE_DB_ADMIN_PASSWORD=
AUTOLIFE_DB_API_PASSWORD=
AUTOLIFE_DB_WORKER_PASSWORD=
AUTOLIFE_DB_MIGRATION_PASSWORD=
AUTOLIFE_S3_ACCESS_KEY=
AUTOLIFE_S3_SECRET_KEY=

AUTOLIFE_AUTH_SECRET=
AUTOLIFE_PUBLIC_ORIGIN=http://127.0.0.1:8080

# FileFlow limits per owner and per API process
AUTOLIFE_FILE_STORAGE_BYTES=1000000000
AUTOLIFE_FILE_OWNER_UPLOADS=2
AUTOLIFE_FILE_UPLOAD_SLOTS=4
